# X (Twitter) API
TWITTER_APP_KEY=
TWITTER_APP_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# ArNS / AR.IO
ANT_PROCESS_ID=        # your ArNS name’s ANT/AO process id
OWNER_ARNS_NAME=       # base ArNS name, e.g. mycoolname (no dots/underscores)

# Wallet (pick one of these two):
# paste raw JWK JSON on one line:
ARWEAVE_JWK_JSON=
# or base64-encode the JSON and paste here:
# ARWEAVE_JWK_B64=

# Optional
DEFAULT_TTL_SECONDS=31536000     # 1 year
POLL_INTERVAL_MS=15000           # how often to check mentions
PORT=3000                         # tiny health server (useful for PaaS)

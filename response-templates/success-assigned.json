{
  "type": "success-assigned",
  "description": "Success message when existing link is assigned",
  "template": [
    "{fallbackMessage}",
    "🎉 Success! Your content is now permanently named!",
    "",
    "🔗 Link assigned: {undername}",
    "",
    "🌐 https://{undername}_{rootArnsName}.ar.io",
    "🔗 ar://{undername}_{rootArnsName}",
    "📋 {txId}",
    "",
    "✨ Powered by @ArNSdomains"
  ],
  "variables": ["undername", "rootArnsName", "txId", "fallbackMessage"],
  "maxLength": 280,
  "fallback": "success-assigned-truncated"
}

{
  "type": "success-uploaded-truncated",
  "description": "Truncated success message for uploaded media when full message is too long",
  "template": [
    "🎉 Media uploaded & named: {undername}",
    "",
    "🌐 https://{undername}_{rootArnsName}.ar.io",
    "📋 {txId}",
    "",
    "✨ Powered by @ArNSdomains"
  ],
  "variables": ["undername", "rootArnsName", "txId"],
  "maxLength": 280,
  "fallback": "success-minimal"
}

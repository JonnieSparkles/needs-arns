{
  "type": "success-post-archive",
  "description": "Success message when post is archived",
  "template": [
    "{fallbackMessage}",
    "🎉 Success! Your post is now permanently archived!",
    "",
    "🌐 https://{undername}_{rootArnsName}.ar.io",
    "🔗 ar://{undername}_{rootArnsName}",
    "📋 {manifestTxId}",
    "",
    "✨ Powered by @ArNSdomains"
  ],
  "variables": ["undername", "rootArnsName", "manifestTxId", "fallbackMessage"],
  "maxLength": 280,
  "fallback": "success-post-archive-truncated"
}


{
  "type": "success-tweet-replica",
  "description": "Success message when tweet replica is created and archived",
  "template": [
    "🎉 Success! Your tweet is now permanently archived!",
    "",
    "📱 Tweet replica created: {undername}",
    "",
    "🌐 https://{undername}_{ownerArnsName}.ar.io",
    "🔗 ar://{undername}_{ownerArnsName}",
    "📋 {manifestTxId}",
    "",
    "✨ Powered by @ArNSdomains"
  ],
  "variables": ["undername", "ownerArnsName", "manifestTxId"],
  "maxLength": 280,
  "fallback": "success-tweet-replica-truncated"
}


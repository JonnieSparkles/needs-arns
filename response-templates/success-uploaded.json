{
  "type": "success-uploaded",
  "description": "Success message when media is uploaded and named",
  "template": [
    "🎉 Success! Your content is now permanently stored on Arweave!",
    "",
    "📸 Media uploaded & named: {undername}",
    "",
    "🌐 https://{undername}_{rootArnsName}.ar.io",

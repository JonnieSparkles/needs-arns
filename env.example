# Twitter API
TWITTER_APP_KEY=your_app_key
TWITTER_APP_SECRET=your_app_secret
TWITTER_ACCESS_TOKEN=your_access_token
TWITTER_ACCESS_SECRET=your_access_secret

# ArNS (configured for mainnet)
ROOT_ARNS_NAME=your_arns_name
ANT_PROCESS_ID=your_process_id
WALLET_ADDRESS=your_wallet_address  # For reference

# Wallet Configuration (pick one of these two):
# Option 1: Path to wallet JSON file
ARWEAVE_WALLET_PATH=./secrets/wallet.json

# Option 2: Raw JWK JSON on one line (alternative to file path)
# ARWEAVE_JWK_JSON={"kty":"RSA","n":"...","e":"AQAB","d":"...","p":"...","q":"...","dp":"...","dq":"...","qi":"..."}

# Shared Credits Configuration (for using credits shared by other wallets)
# Enable automatic shared credits usage - SDK will automatically find and use available
# credit share approvals (closest to expiration first, then lowest amounts, then signer's balance)
TURBO_USE_SHARED_CREDITS=true

# Optional: Explicit comma-separated payer addresses (overrides auto-discovery)
# TURBO_SHARED_CREDITS_PAID_BY=addr1,addr2,addr3

# Optional
DEFAULT_TTL_SECONDS=60  # ArNS allows 60-86400 seconds (1 min - 24 hours)
POLL_INTERVAL_MINUTES=240  # XX MINUTES for Twitter
PORT=3000

# Post Template System
TEMPLATE_HTML_TXID=template_txid  # Shared HTML template txId for tweet replicas 

# Access Control (optional - leave empty for open access)
ALLOWED_USERS=username1,username2,username3  # Comma-separated list (without @)

# Time-based filtering (optional)
MENTION_MAX_AGE_HOURS=24  # Only process mentions from last XX HOURS

# Retweet behavior (optional)
ENABLE_RETWEETS=true  # Set to false to disable retweets (saves posts for rate limits)